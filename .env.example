# Optional. Without a .env, notifications go to the bundled mock provider.
# Copy to .env and set your own webhook.site URL to use it instead:
# PROVIDER_URL=https://webhook.site/your-uuid

# Stage provider failures with the mock provider (docker compose up again to apply):
# MOCK_FAILURE_RATE=0.3
# MOCK_LATENCY=150ms
# MOCK_STATUS=503

# Defaults (see docs/DESIGN.md, section "Configuration"):
# RATE_LIMIT_PER_CHANNEL=100
# WORKERS_PER_CHANNEL=20
# PRIORITY_WEIGHTS=6,3,1
# QUEUE_THRESHOLDS=600,300,100
# DISPATCH_INTERVAL=1s
# VISIBILITY_TIMEOUT=5m
# LEASE_DURATION=30s
# PROVIDER_TIMEOUT=5s
# RETRY_BASE=1s
# RETRY_CAP=5m
# MAX_ATTEMPTS=5
# BREAKER_THRESHOLD=5
# BREAKER_COOLDOWN=30s
# LOG_LEVEL=info
